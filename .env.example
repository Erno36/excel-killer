# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
CRUZADOR_WEB_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO
CRUZADOR_WEB_COOKIE_SECURE=1
CRUZADOR_WEB_LOG_DIR=/var/log/cruzador-excel-web
CRUZADOR_WEB_DB_PATH=/var/lib/cruzador-excel-web/cruzador.db
CRUZADOR_WEB_RECIPES_DIR=/var/lib/cruzador-excel-web/recipes
APP_ENV=production

# Por defecto solo escucha en esta PC. Para una prueba LAN, usa la IP fija
# del servidor y limita los clientes a IPs explicitas; no uses 0.0.0.0.
CRUZADOR_WEB_BIND_HOST=127.0.0.1
CRUZADOR_WEB_ALLOWED_CLIENTS=
